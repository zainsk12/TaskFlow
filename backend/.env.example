# =============================================================================
# TaskFlow backend — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values for local development, OR set
# these as environment variables in your deployment platform (Render).
# `.env` is gitignored and must NEVER be committed. This file holds placeholders
# only — no real secrets.
#
# NOTE: Spring Boot does not read `.env` files automatically. For local dev,
# either export these into your shell, configure them in your IDE run config, or
# use a tool like `direnv`/`dotenv` to load them before starting the app.

# --- MongoDB (required in production) ---
# Full Atlas SRV connection string, including credentials and database name.
# If unset, the app falls back to a local mongod at mongodb://localhost:27017/taskflow.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority&appName=Cluster0

# --- JWT (required in production) ---
# HS256 signing secret, MUST be >= 256 bits (32+ chars). Generate a random value
# and rotate it if ever exposed. If unset, a known dev-only placeholder is used
# (NOT safe for production).
JWT_SECRET=change-me-to-a-long-random-32+-char-secret

# Optional token lifetimes (durations, e.g. 15m, 7d). Defaults shown.
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash).
# Local dev default is http://localhost:5173. In production set this to your
# Vercel deployment URL, e.g. https://taskflow.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Server ---
# Render injects PORT automatically; leave unset locally to use 8080.
# PORT=8080
