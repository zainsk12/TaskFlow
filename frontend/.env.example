# Base URL of the backend API. In dev this is left as the default relative path
# (/api/v1), which Vite proxies to http://localhost:8080 (see vite.config.js).
# In production, set this to the deployed API origin (the Render backend), e.g.
# https://<your-service>.onrender.com/api/v1
VITE_API_URL=/api/v1
